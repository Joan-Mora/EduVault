# Copia este archivo como .env y completa los valores. No subas .env al repositorio.

# Django
SECRET_KEY=cambia-esta-clave

# Base de datos (formato dj-database-url)
DATABASE_URL=postgres://usuario:clave@localhost:5432/eduvault

# Almacenamiento de archivos en Amazon S3 (django-storages)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# Inicio de sesión con Google (django-allauth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
